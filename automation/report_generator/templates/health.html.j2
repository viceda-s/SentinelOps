<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>SentinelOps — Health</title>

    <style>
        body {
            font-family: system-ui, sans-serif;
            margin: 2rem;
            color: #222;
        }

        h1,
        h2 {
            margin-top: 2rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        th,
        td {
            border: 1px solid #d0d0d0;
            padding: 0.5rem;
            text-align: left;
        }

        th {
            background: #f5f5f5;
        }

        .critical {
            color: #c62828;
            font-weight: 600;
        }

        .warning {
            color: #ef6c00;
            font-weight: 600;
        }

        .healthy {
            color: #2e7d32;
            font-weight: 600;
        }
    </style>
</head>

<body>

<h1>SentinelOps Health</h1>

<h2>Services</h2>

<table>
    <thead>
        <tr>
            <th>Service</th>
            <th>Status</th>
            <th>Severity</th>
        </tr>
    </thead>

    <tbody>
    {% for service in model.services %}
        <tr>
            <td>{{ service.name }}</td>

            <td>
                {% if service.status == "healthy" %}
                    <span class="healthy">healthy</span>
                {% else %}
                    {{ service.status }}
                {% endif %}
            </td>

            <td class="{{ service.severity or '' }}">
                {{ service.severity or "—" }}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>


<h2>Open incidents by severity</h2>

<table>
    <thead>
        <tr>
            <th>Severity</th>
            <th>Count</th>
        </tr>
    </thead>

    <tbody>
    {% if model.counts_by_severity %}
        {% for severity, count in model.counts_by_severity.items() %}
            <tr>
                <td class="{{ severity }}">{{ severity }}</td>
                <td>{{ count }}</td>
            </tr>
        {% endfor %}
    {% else %}
        <tr>
            <td colspan="2">No active incidents</td>
        </tr>
    {% endif %}
    </tbody>
</table>


<h2>Open incidents</h2>

{% if model.open_incidents %}
<table>
    <thead>
        <tr>
            <th>Reference</th>
            <th>Service</th>
            <th>Status</th>
            <th>Severity</th>
            <th>Alert</th>
        </tr>
    </thead>

    <tbody>
    {% for incident in model.open_incidents %}
        <tr>
            <td>{{ incident.reference }}</td>
            <td>{{ incident.service }}</td>
            <td>{{ incident.status }}</td>
            <td class="{{ incident.severity }}">{{ incident.severity }}</td>
            <td>{{ incident.alert_name }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% else %}
<p>None active</p>
{% endif %}


<h2>Maintenance windows</h2>

{% if model.active_maintenance_windows %}
<table>
    <thead>
        <tr>
            <th>Service</th>
            <th>Ends</th>
        </tr>
    </thead>

    <tbody>
    {% for window in model.active_maintenance_windows %}
        <tr>
            <td>{{ window.service }}</td>
            <td>{{ window.ends_at }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% else %}
<p>None active</p>
{% endif %}

</body>
</html>
